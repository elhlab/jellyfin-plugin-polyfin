<Project>
    <!-- Read the version from build.yaml so dev builds match releases. -->
    <PropertyGroup>
        <BuildYaml>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build.yaml'))</BuildYaml>
        <BuildYamlVersion>$([System.Text.RegularExpressions.Regex]::Match($(BuildYaml), '(?m)^version:\s*["\x27]?([^"\x27\s#]+)').Groups[1].Value)</BuildYamlVersion>
        <Version>$(BuildYamlVersion)</Version>
    </PropertyGroup>

    <Target Name="CheckBuildYamlVersion" BeforeTargets="Build" Condition="'$(BuildYamlVersion)' == ''">
        <Error Text="Couldn't read the version from build.yaml." />
    </Target>
</Project>
